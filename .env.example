PORT=8000
BIND_HOST=::
# SANDBOX_ROOT=/absolute/path/to/allowed/folder
NGROK_URL=https://your-subdomain.ngrok-free.dev

# --- P2 auth ---
# GitHub OAuth App credentials for owner login (client_secret is app, not owner, identity)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub login that is allowed to approve MCP clients
OWNER_GITHUB=
# Public base URL of the tunnel (issuer + redirect base)
BASE_URL=https://your-tunnel.ngrok-free.dev
SENSITIVE_FILES=*.sensitive,file,globs*
DENIED_FOLDERS=*.denied,folder,globs*
